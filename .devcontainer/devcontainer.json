{
  "name": "CS 201 Course Assistant",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  // Asked for when a student creates the codespace. Each one is optional:
  // a key entered here becomes an env var and pre-fills the app's sidebar.
  "secrets": {
    "GOOGLE_API_KEY": {
      "description": "Gemini API key (default model; free tier works).",
      "documentationUrl": "https://aistudio.google.com/apikey"
    },
    "ANTHROPIC_API_KEY": {
      "description": "Optional: Claude API key.",
      "documentationUrl": "https://console.anthropic.com/settings/keys"
    },
    "OPENAI_API_KEY": {
      "description": "Optional: OpenAI API key."
    },
    "LANGFUSE_PUBLIC_KEY": {
      "description": "Optional: Langfuse public key, to see traces.",
      "documentationUrl": "https://cloud.langfuse.com"
    },
    "LANGFUSE_SECRET_KEY": {
      "description": "Optional: Langfuse secret key."
    }
  },

  // Installs uv and the project's dependencies once, when the codespace is built
  // (and when a prebuild runs).
  "onCreateCommand": "pip install --user --quiet uv && ~/.local/bin/uv sync",
  "postCreateCommand": "[ -f .env ] || cp .env.example .env",

  // Starts the app every time a student opens the codespace.
  "postAttachCommand": "uv run python server.py --host 0.0.0.0 --no-browser",

  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Course Assistant", "onAutoForward": "openBrowser" }
  },

  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "demo_uploads/README.md"]
    },
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  }
}
