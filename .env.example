# Copy to .env. Anything set here pre-fills the sidebar, so you never type a
# secret on a projected screen. Everything is optional.

ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Model ids per provider (Claude defaults to claude-opus-5-5)
CLAUDE_MODEL=claude-opus-5-5
GEMINI_MODEL=
OPENAI_MODEL=

# Langfuse Cloud. Leave empty to run without tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# The clock. Default: real time, with the demo data built around the day you
# press Reset demo. To rehearse a specific day, pin it (it starts there on reset
# and runs forward):
# DEMO_NOW=2026-12-01T14:00

# Where demo data lives (default: ./runtime)
# COURSE_RUNTIME=
